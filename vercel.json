{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/hourly-stock",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/server.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/server.js"
    },
    {
      "source": "/((?!assets/|images/|ambassadors/).*)",
      "destination": "/index.html"
    }
  ]
}
