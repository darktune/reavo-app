{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!assets/|images/|ambassadors/|founders/|videos/|logos/|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
