# ==========================================
# REAVO ECOSYSTEM ENVIRONMENT TEMPLATE
# Copy to .env and fill in your values
# ==========================================

# 1. Google Gemini AI API Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Cloud Database & Authentication
# Obtain from your Supabase Project Settings > API: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2b. Supabase Service Role Key (SERVER-SIDE ONLY — NEVER prefix with VITE_)
# Used by server API routes to bypass RLS for secure order processing.
# Obtain from Supabase Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. KoraPay Payment Gateway Credentials
# Obtain from your KoraPay Merchant Dashboard: https://dashboard.korapay.com/
# Use pk_test_... and sk_test_... during staging; swap for pk_live_... and sk_live_... in production
VITE_KORA_PUBLIC_KEY=pk_test_your_public_key_here
KORAPAY_SECRET_KEY=sk_test_your_secret_key_here

# 4. Email (Nodemailer) SMTP Configuration
# For Gmail: Use smtp.gmail.com with an App Password (not your personal password)
# For SendGrid / AWS SES: Use their respective host and API credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
ADMIN_EMAIL=admin@reavoglobal.com

# 5. Node Backend Server & Internal Secrets
PORT=3001
CRON_SECRET=your_secure_cron_passphrase_here

# 6. Live Custom Domain & SEO URL (Set this in Vercel Environment Variables)
# Production: https://www.reavoglobal.com
VITE_SITE_URL=https://www.reavoglobal.com
SITE_URL=https://www.reavoglobal.com

